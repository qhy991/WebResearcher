# Tavily API配置
TAVILY_API_KEY=your_tavily_api_key_here

# 代理配置（可选）
HTTP_PROXY=http://10.20.5.43:7891
HTTPS_PROXY=http://10.20.5.43:7891

# LLM配置（可选，用于生成详细答案）
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama配置（本地模型，不需要API密钥）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=Qwen2.5-Coder:14B

# LLM答案生成配置
USE_LLM_ANSWER=false
LLM_PROVIDER=ollama  # openai, anthropic, or ollama
LLM_MODEL=Qwen2.5-Coder:14B

# 搜索配置
MAX_RESULTS=10
SEARCH_DEPTH=advanced  # basic or advanced
INCLUDE_RAW_CONTENT=false

# LLM答案生成参数（可调整）
LLM_MAX_RESULTS=5  # 发送给LLM的结果数量
LLM_CONTENT_LENGTH=500  # 每个结果发送给LLM的字符数
LLM_HIGH_RELEVANCE_LENGTH=1000  # 高相关性结果的内容长度
LLM_MEDIUM_RELEVANCE_LENGTH=500  # 中等相关性结果的内容长度
LLM_LOW_RELEVANCE_LENGTH=300  # 低相关性结果的内容长度

# 输出配置
OUTPUT_DIR=data
AUTO_SAVE=true
